# Server-side only. Copy to .env at the repository root. Never commit secrets.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4000/auth/twitch/callback
# Local OBS Studio: Tools > WebSocket Server Settings. Enable authentication.
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=
# Optional bot account excluded from activity; never a token.
TWITCH_BOT_USER_ID=
